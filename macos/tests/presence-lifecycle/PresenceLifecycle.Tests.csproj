<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Chill with You Lo-Fi Story/Chill With You.app/Contents/Resources/Data/Managed</GameManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json" Condition="Exists('$(GameManagedDir)/Newtonsoft.Json.dll')"><HintPath>$(GameManagedDir)/Newtonsoft.Json.dll</HintPath></Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" Condition="!Exists('$(GameManagedDir)/Newtonsoft.Json.dll')" />
    <Compile Include="Program.cs;../../src/MusicBridge/SteamPresenceService.cs;../../src/MusicBridge/SteamPresenceOptions.cs;../../src/MusicBridge/SteamPresencePublisher.cs;../../src/MusicBridge/SteamPresenceFormatter.cs;../../src/MusicBridge/TimerSnapshot.cs;../../src/MusicBridge/PlaybackState.cs" />
  </ItemGroup>
</Project>
